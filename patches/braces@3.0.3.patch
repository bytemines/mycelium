diff --git a/lib/validate.js b/lib/validate.js
new file mode 100644
index 0000000000000000000000000000000000000000..7845d21cb9c3c57d01205d7cf28caa27d23cceea
--- /dev/null
+++ b/lib/validate.js
@@ -0,0 +1,39 @@
+'use strict';
+
+// GHSA-vfj7-8cjw-p6xm: bound recursive walkers, including caller-supplied ASTs.
+// Public parse/compile/expand/stringify reject AST depth >128 (127 nested
+// brace/paren blocks plus leaves) or cycles with SyntaxError, not stack overflow.
+// Callers accepting untrusted patterns must catch this validation failure.
+const assertDepth = depth => {
+  if (depth > 128) throw new SyntaxError('Brace AST depth exceeds security limit (128)');
+};
+
+const validate = ast => {
+  const active = new Set();
+  const stack = [{ node: ast, index: -1 }];
+  while (stack.length) {
+    const frame = stack[stack.length - 1];
+    const node = frame.node;
+    if (frame.index === -1) {
+      assertDepth(stack.length - 1);
+      if (active.has(node)) throw new SyntaxError('Cyclic brace AST');
+      active.add(node);
+      // expand also follows parent links; these must be bounded and acyclic.
+      let parent = node;
+      let depth = 0;
+      while (parent && parent.parent) {
+        assertDepth(++depth);
+        parent = parent.parent;
+      }
+      frame.index = 0;
+    }
+    if (node.nodes && frame.index < node.nodes.length) {
+      stack.push({ node: node.nodes[frame.index++], index: -1 });
+    } else {
+      active.delete(node);
+      stack.pop();
+    }
+  }
+};
+
+module.exports = { assertDepth, validate };
