{
  "name": "@mycelish/cli",
  "version": "0.3.8",
  "description": "CLI for Mycelium - Universal AI Tool Orchestrator",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mycelium": "./dist/index.js",
    "myc": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../build-package.mjs cli",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bytemines/mycelium"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.9",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mycelish/core": "workspace:*",
    "commander": "^14.0.3",
    "express": "^5.3.0",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
